{
    "name": "chakracoder/laravel-query-budget",
    "description": "Query budgets for Laravel: assert query counts, duplicates and N+1 patterns in tests and enforce per-route budgets in local and CI environments.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "n-plus-one", "database", "queries", "testing", "pest", "phpunit", "performance"],
    "authors": [
        {
            "name": "Yagnang Vyas",
            "email": "168338381+ChakraCoder@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/log": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "ChakraCoder\\QueryBudget\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChakraCoder\\QueryBudget\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --coverage --min=90",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ChakraCoder\\QueryBudget\\QueryBudgetServiceProvider"
            ],
            "aliases": {
                "QueryBudget": "ChakraCoder\\QueryBudget\\Facades\\QueryBudget"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
